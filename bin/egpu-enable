#!/bin/bash
VENDOR=$1 # Capture 'nvidia' or 'amd' from the plugin
OS_TYPE=$2
LOG_DIR=$3
DATA_DIR=$4
SUPERGFX_TRIG=0
#PRIMARY_USER=$(echo "$LOG_DIR" | cut -d/ -f3)
PRIMARY_USER=$(ps -o user= -C steam | head -n 1 | xargs)
[ -z "$PRIMARY_USER" ] && PRIMARY_USER="deck"
mkdir -p "$DATA_DIR/configs"
exec > "$LOG_DIR/xgmobile_manager_enable_${VENDOR}.log" 2>&1

# steamos-readonly is SteamOS-only; CachyOS has a mutable FS so this is a no-op there
steamos_readonly() { command -v steamos-readonly &>/dev/null && steamos-readonly "$@" || true; }

echo "--- XG Mobile Enable ($VENDOR) Started at $(date) ---"

# Hardware Lock Check
# Primary: use asus-nb-wmi sysfs (SteamOS/standard kernels)
# Fallback: if sysfs node absent (e.g. CachyOS deckify kernel without WMI eGPU patch),
# check for an NVIDIA GPU already on the PCIe bus — the BIOS brings the link up at boot
# when the XG Mobile is physically connected and locked.
CONN_PATH="/sys/devices/platform/asus-nb-wmi/egpu_connected"
if [ -f "$CONN_PATH" ]; then
  CONNECTED=$(cat "$CONN_PATH")
  if [ "$CONNECTED" -eq 0 ]; then
    echo "ERROR: XG Mobile not locked (egpu_connected=0)."
    exit 1
  fi
else
  echo "WARNING: egpu_connected sysfs unavailable. Falling back to PCIe bus detection..."
  echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
  if ! lspci -d 10de: | grep -qE "VGA|3D|Display"; then
    echo "ERROR: No NVIDIA GPU found on PCIe bus and egpu_connected unavailable. Is the XG Mobile locked in?"
    exit 1
  fi
  echo "NVIDIA GPU detected on PCIe bus. Proceeding without WMI lock confirmation."
fi

if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]];  then
  # check if its NVIDIA and if so, check for drivers before continuing
  if [ "$VENDOR" == "nvidia" ]; then
    # Check if the kernel module is actually loadable
    if ! modinfo nvidia >/dev/null 2>&1; then
      echo "ERROR: NVIDIA Driver is not installed. Please run the Install NVIDIA drivers button, or select AMD."
      exit 2
    fi
    if [ ! -f "$DATA_DIR/configs_backup/nvidia_icd.json" ] && [ ! -f "/usr/share/vulkan/icd.d/nvidia_icd.json" ]; then
      if [ -f "/home/deck/xgmobile_configs_backup/nvidia_icd.json" ]; then
        echo "CRITICAL ERROR: NVIDIA Vulkan configs detected in old folder location due to v0.2.0 migration."
        echo "Please use the 'Install NVIDIA Drivers' button in the plugin to regenerate them."
        exit 3
      else
        echo "CRITICAL ERROR: NVIDIA Vulkan configs missing due to v0.2.0 migration."
        echo "Please use the 'Install NVIDIA Drivers' button in the plugin to regenerate them."
        exit 4
      fi
    fi
  fi

  # SELF-HEALING BLOCK (Replaces repair-services)
  echo "Verifying system services..."
  REPO_ROOT=$(readlink -f "$(dirname "$(readlink -f "$0")")/..")
  NEEDS_REPAIR=0

  # Check if global commands are missing
  [ ! -L /usr/local/bin/egpu-enable ] && NEEDS_REPAIR=1

  # Check if NVIDIA services/sleep scripts are missing
  if [ "$VENDOR" == "nvidia" ]; then
    [ ! -f /etc/systemd/system/nvidia-suspend.service ] && NEEDS_REPAIR=1
  fi

  if [ "$NEEDS_REPAIR" -eq 1 ]; then
    echo "System files missing. Initiating self-repair..."
    steamos_readonly disable
  
    # Restore global terminal commands
    ln -sf "$REPO_ROOT/bin/egpu-enable" /usr/local/bin/egpu-enable
    ln -sf "$REPO_ROOT/bin/egpu-eject" /usr/local/bin/egpu-eject
    ln -sf "$REPO_ROOT/bin/egpu-sync" /usr/local/bin/egpu-sync
    chmod +x "$REPO_ROOT/bin/egpu-enable" "$REPO_ROOT/bin/egpu-eject" "$REPO_ROOT/bin/egpu-sync"
  
    # Copy background services
    cp "$REPO_ROOT/assets/services/"*.service /etc/systemd/system/ 2>/dev/null || true
    systemctl enable xgmobile-boot-sync.service

    if [ "$VENDOR" == "nvidia" ]; then
      echo "Restoring NVIDIA sleep services..."
      systemctl daemon-reload
      systemctl enable nvidia-persistenced nvidia-powerd nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service 2>/dev/null
      systemctl start nvidia-persistenced 2>/dev/null
    else
      systemctl daemon-reload
    fi
    steamos_readonly enable
    echo "Self-repair complete."
  fi
fi

if [[ "$OS_TYPE" == *"bazzite"* ]]; then
  # SELF-HEALING: install the boot-sync service so a reboot without running
  # egpu-eject doesn't leave stale /etc/modprobe.d/nvidia-egpu.conf (modeset=1)
  # and /etc/environment.d/xgmobile-nvidia.conf around. On BIOS-managed eGPU
  # hardware (no asus-nb-wmi egpu_enable sysfs), egpu-sync wipes these on every
  # boot before display-manager starts; without it, leftover modeset=1 makes
  # nvidia_drm auto-load via udev at boot and hang trying to KMS a GPU with no
  # display attached, crashing the handheld UI.
  REPO_ROOT=$(readlink -f "$(dirname "$(readlink -f "$0")")/..")
  if [ ! -L /usr/local/bin/egpu-sync ] || ! systemctl is-enabled --quiet xgmobile-boot-sync.service 2>/dev/null; then
    echo "Installing boot-sync service for clean reboots..."
    ln -sf "$REPO_ROOT/bin/egpu-enable" /usr/local/bin/egpu-enable
    ln -sf "$REPO_ROOT/bin/egpu-eject" /usr/local/bin/egpu-eject
    ln -sf "$REPO_ROOT/bin/egpu-sync" /usr/local/bin/egpu-sync
    chmod +x "$REPO_ROOT/bin/egpu-enable" "$REPO_ROOT/bin/egpu-eject" "$REPO_ROOT/bin/egpu-sync"
    cp "$REPO_ROOT/assets/services/xgmobile-boot-sync.service" /etc/systemd/system/ 2>/dev/null || true
    systemctl daemon-reload
    systemctl enable xgmobile-boot-sync.service

    # SELinux: scripts live under /home/.../homebrew (user_home_t), which init_t
    # (systemd services like xgmobile-boot-sync) is not allowed to execute,
    # causing "Permission denied" even though Unix permissions are correct.
    # Persistently relabel them as bin_t so the boot-time service can run them.
    if command -v semanage >/dev/null 2>&1; then
      semanage fcontext -a -t bin_t "${REPO_ROOT}/bin/egpu-(enable|eject|sync)" 2>/dev/null || true
      restorecon -v "$REPO_ROOT/bin/egpu-enable" "$REPO_ROOT/bin/egpu-eject" "$REPO_ROOT/bin/egpu-sync" 2>/dev/null || true
    fi
  fi
fi

# Prevent the eGPU's NVIDIA modules from auto-loading via udev/PCI hotplug at
# boot on BIOS-managed handhelds (no asus-nb-wmi egpu_enable sysfs). A cold
# boot with the XG Mobile already connected otherwise auto-loads nvidia_drm
# with modeset=1 (the distro default) against a GPU with no display attached,
# which hangs forever in "Error while waiting for GPU progress" and crashes
# the handheld UI / blanks the screen. Blacklisting only blocks alias/udev
# auto-load — the explicit `modprobe nvidia_drm ...` calls below (by exact
# module name) still work when the user activates the eGPU.
PRODUCT_NAME_CHK=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "Unknown")
if [ ! -f /sys/devices/platform/asus-nb-wmi/egpu_enable ] && [[ "$PRODUCT_NAME_CHK" == *"RC71L"* || "$PRODUCT_NAME_CHK" == *"Ally"* ]] && [ ! -f /etc/modprobe.d/nvidia-egpu-noauto.conf ]; then
  echo "Blacklisting NVIDIA auto-load at boot (BIOS-managed handheld eGPU)..."
  cat > /etc/modprobe.d/nvidia-egpu-noauto.conf << 'EOF'
# XG Mobile Manager: prevent the eGPU's NVIDIA modules from auto-loading via
# udev/PCI hotplug at boot. A cold boot with the XG Mobile connected would
# otherwise auto-load nvidia_drm (modeset=1) against a headless GPU and hang.
# egpu-enable still loads these modules explicitly by name on demand, which
# bypasses this blacklist.
blacklist nvidia
blacklist nvidia_drm
blacklist nvidia_modeset
blacklist nvidia_uvm
EOF
fi

if [ -L /usr/lib/systemd/system-sleep/egpu-resume-fix ] || [ -f /usr/lib/systemd/system-sleep/egpu-resume-fix ]; then
  echo "Purging obsolete legacy egpu-resume-fix..."
  steamos_readonly disable
  rm -f /usr/lib/systemd/system-sleep/egpu-resume-fix
  rm -f /etc/systemd/system/egpu-resume-fix.service
  rm -f /etc/systemd/system/egpu-boot-guardian.service
  steamos_readonly enable
fi

if systemctl is-active --quiet supergfxd.service; then 
  echo "Supergfxd Detected. Stopping supergfxd to avoid panic during switch..."
  systemctl stop supergfxd.service 2>/dev/null || true
  SUPERGFX_TRIG=1
fi

# Used for all OSes for consistency
# Hardware Activation
EXISTING_CARDS=$(ls /dev/dri/card* 2>/dev/null)
IGPU_CARD=""  # set after EGPU_CARD is known
ENABLE_PATH="/sys/devices/platform/asus-nb-wmi/egpu_enable"
if [ -f "$ENABLE_PATH" ]; then
  if [ "$(cat $ENABLE_PATH)" -eq 0 ]; then
    echo 1 > "$ENABLE_PATH" || true
  fi
else
  echo "NOTE: egpu_enable sysfs unavailable. PCIe link assumed already active (BIOS-managed)."
fi
echo 1 > /sys/bus/pci/rescan

sleep 2

if [[ "$OS_TYPE" == *"bazzite"* ]]; then
  if [ "$VENDOR" == "nvidia" ]; then
    echo "Loading NVIDIA drivers into kernel to generate DRM nodes..."
    systemctl enable nvidia-persistenced nvidia-powerd 2>/dev/null
    systemctl start nvidia-persistenced nvidia-powerd 2>/dev/null
    modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia 2>/dev/null || true
    modprobe nvidia_drm modeset=1 fbdev=1
    modprobe nvidia_modeset nvidia_uvm nvidia
  fi
fi

# Wait for Hardware
COUNT=0
EGPU_CARD=""
while [ -z "$EGPU_CARD" ] && [ $COUNT -lt 15 ]; do
  echo "Waiting for eGPU card... ($COUNT)"
  CURRENT_CARDS=$(ls /dev/dri/card* 2>/dev/null)
  for card in $CURRENT_CARDS; do
    if ! echo "$EXISTING_CARDS" | grep -q "$card"; then
      EGPU_CARD=$card
      break
    fi
  done
  [ -n "$EGPU_CARD" ] && break
  sleep 1
  ((COUNT++))
done

# Fallback: when egpu_enable sysfs is absent (BIOS-managed PCIe), the GPU is already
# on the bus at boot so no "new" card appears — find the NVIDIA card by vendor ID.
if [ -z "$EGPU_CARD" ] && [ ! -f "/sys/devices/platform/asus-nb-wmi/egpu_enable" ]; then
  echo "No new card detected. Trying vendor-based DRM detection (BIOS-managed path)..."
  for vendor_path in /sys/class/drm/card*/device/vendor; do
    if [ "$(cat "$vendor_path" 2>/dev/null)" == "0x10de" ]; then
      EGPU_CARD="/dev/dri/$(basename "$(dirname "$(dirname "$vendor_path")")")"
      echo "Found NVIDIA DRM node by vendor: $EGPU_CARD"
      break
    fi
  done
fi

if [ -z "$EGPU_CARD" ]; then
  echo "ERROR: Hardware failed to appear in /dev/dri/"
  exit 5
fi
echo "Success! eGPU dynamically detected as: $EGPU_CARD"
# IGPU_CARD = whichever /dev/dri/card* is not the eGPU.
# Done here so card numbering doesn't matter (no sysfs vendor traversal needed).
for _card in /dev/dri/card*; do
  [ "$_card" != "$EGPU_CARD" ] && { IGPU_CARD="$_card"; break; }
done
[ -z "$IGPU_CARD" ] && IGPU_CARD=$(echo "$EXISTING_CARDS" | head -n 1)
echo "iGPU card: $IGPU_CARD"
#if [[ "$OS_TYPE" == *"bazzite"* ]]; then
#  echo "Applying Bazzite overlay environment fixes..."
#  USER_UID=$(id -u $PRIMARY_USER)
#  export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
#  
#  systemctl set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
#  sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
#fi
  # STOP UI
# We must stop sddm so we can unload the driver modules
echo "Stopping SDDM..."
systemctl stop display-manager

 
if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
# DRIVER RELOAD 
  if [ "$VENDOR" == "nvidia" ]; then
    echo "Detecting NVIDIA Hardware ID..."
    NVIDIA_ID=$(lspci -n -d 10de: | head -n 1 | awk '{print $3}')
  
    if [ -z "$NVIDIA_ID" ]; then
      echo "ERROR: Could not detect an NVIDIA GPU ID on the PCIe bus. Aborting."
      exit 6
    fi
    echo "Dynamic Hardware Lock: $NVIDIA_ID"

    echo "Re-fanging NVIDIA configs for active session..."
    steamos_readonly disable
    # 10_nvidia.json (EGL vendor, priority 10) is intentionally NOT restored here.
    # Restoring it makes NVIDIA EGL the system default, which crashes gamescope.
    # Steam and gamescope use AMD EGL (50_mesa.json) for display; NVIDIA EGL is
    # only needed for render offload scenarios that set it explicitly per-game.
    #
    # nvidia_icd.json (Vulkan ICD) is also NOT restored globally here.
    # gamescope selects AMD Vulkan via MESA_VK_DEVICE_SELECT; if the NVIDIA ICD is
    # in the global icd.d path, Steam's Vulkan stack may enumerate NVIDIA first,
    # which fails when NVIDIA has no render node (/dev/dri/renderD129 absent until
    # nvidia_drm fully creates it). PRIME render offload is handled per-game via
    # VK_ICD_FILENAMES or DRI_PRIME env vars set in the game launch options.
    mv $DATA_DIR/configs_backup/*layer* /usr/share/vulkan/implicit_layer.d/ 2>/dev/null || true
    mv $DATA_DIR/configs_backup/*layer* /usr/share/vulkan/explicit_layer.d/ 2>/dev/null || true
    mv $DATA_DIR/configs_backup/10-nvidia* /usr/share/X11/xorg.conf.d/ 2>/dev/null || true
    steamos_readonly enable

    # This is what forces the NVIDIA card into Wayland mode
    echo "Stopping NVIDIA services before module reload..."
    systemctl stop nvidia-persistenced nvidia-powerd 2>/dev/null || true
    fuser -kv /dev/nvidia* >/dev/null 2>&1 || true
    echo "Loading NVIDIA modules..."
    modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia 2>/dev/null || true
    modprobe nvidia_drm modeset=1 fbdev=1
    modprobe nvidia_modeset nvidia_uvm nvidia

    # Permissions — must run AFTER modprobe so we set ACLs on the freshly-created nodes,
    # not on the old nodes that were destroyed by modprobe -r.
    echo "Setting permissions for user: $PRIMARY_USER"
    setfacl -m u:$PRIMARY_USER:rw $EGPU_CARD
    setfacl -m u:$PRIMARY_USER:rw /dev/dri/renderD*
    if [ -e /dev/nvidiactl ]; then
      echo "Granting NVIDIA node permissions..."
      setfacl -m "u:$PRIMARY_USER:rw" /dev/nvidia*
    fi

    # PERSISTENT DRIVER SETTINGS
    # Write modeset=1 for this session (egpu-eject removes it; boot-sync removes it on reboot).
    echo "Setting NVIDIA config file for persistence..."
    echo "options nvidia_drm modeset=1 fbdev=1" > /etc/modprobe.d/nvidia-egpu.conf

    # PERSISTENT ENVIRONMENT (drop-in file — boot-sync removes on reboot, eject removes on eject)
    # Using /etc/environment.d/ so the file can be atomically created/deleted without
    # corrupting /etc/environment, and boot-sync can safely rm -f it on every startup.
    echo "Writing environment variables to disk..."
    # Detect AMD GPU PCI vendor:device for MESA_VK_DEVICE_SELECT.
    # Strip leading 0x so the format matches what the Mesa layer expects (e.g. "1002:150e").
    AMD_PCI_DEVICE=$(cat /sys/class/drm/$(basename $IGPU_CARD)/device/device 2>/dev/null | sed 's/0x//')
    if [ -z "$AMD_PCI_DEVICE" ]; then
      AMD_PCI_DEVICE="150e"  # ROG Ally X iGPU fallback
    fi
    MESA_VK_SELECT="1002:${AMD_PCI_DEVICE}"

    mkdir -p /etc/environment.d
    cat > /etc/environment.d/xgmobile-nvidia.conf << EOF
WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT
EOF

    # Environment Injection (System-Wide)
    # AMD is first in WLR_DRM_DEVICES so gamescope uses AMD Vulkan for display (NVIDIA Vulkan
    # needs an X display to init — it becomes available for render offload once the session starts).
    # MESA_VK_DEVICE_SELECT forces gamescope AND Steam to select the AMD iGPU for Vulkan;
    # without it gamescope picks NVIDIA (more powerful) which has no connected display → blank screen.
    echo "Injecting variables into systemd session..."
    systemctl set-environment WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
    systemctl set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
    systemctl set-environment MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT

    # Environment Injection (User-Session Fix)
    # We explicitly define the XDG_RUNTIME_DIR so root can talk to the deck session
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT

    echo "Creating isolated KDE Plasma environment config..."
    PLASMA_ENV_DIR="/home/$PRIMARY_USER/.config/plasma-workspace/env"
    sudo -u $PRIMARY_USER mkdir -p "$PLASMA_ENV_DIR"
  
    sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
EOF"
    chmod +x "$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh"

    # Final Reload & Start
    echo "Daemon-reload and start SDDM..."
    systemctl daemon-reload
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user daemon-reload

  elif [ "$VENDOR" == "amd" ]; then
    echo "AMD Vendor detected. Injecting minimal variables to prioritize the new GPU..."
    echo "Writing environment variables to disk..."
    mkdir -p /etc/environment.d
    echo "WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD" > /etc/environment.d/xgmobile-nvidia.conf
    echo "Injecting variables into systemd session..."
    systemctl set-environment WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD

    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD

  fi
fi

if [[ "$OS_TYPE" == *"bazzite"* ]]; then
  if [ "$VENDOR" == "nvidia" ]; then
    NVIDIA_ID=$(lspci -n -d 10de: | head -n 1 | awk '{print $3}')
    echo "Dynamic Hardware Lock: $NVIDIA_ID"

    # Permissions — set ACLs on the nodes created by the early modprobe
    echo "Setting permissions for user: $PRIMARY_USER"
    setfacl -m u:$PRIMARY_USER:rw $EGPU_CARD
    setfacl -m u:$PRIMARY_USER:rw /dev/dri/renderD*
    if [ -e /dev/nvidiactl ]; then
      echo "Granting NVIDIA node permissions..."
      setfacl -m "u:$PRIMARY_USER:rw" /dev/nvidia*
    fi

    echo "Setting NVIDIA config file for persistence..."
    echo "options nvidia_drm modeset=1 fbdev=1" > /etc/modprobe.d/nvidia-egpu.conf

    echo "Writing environment variables to disk..."
    AMD_PCI_DEVICE=$(cat /sys/class/drm/$(basename $IGPU_CARD)/device/device 2>/dev/null | sed 's/0x//')
    [ -z "$AMD_PCI_DEVICE" ] && AMD_PCI_DEVICE="150e"
    MESA_VK_SELECT="1002:${AMD_PCI_DEVICE}"

    mkdir -p /etc/environment.d
    cat > /etc/environment.d/xgmobile-nvidia.conf << EOF
WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT
EOF

    echo "Injecting variables into systemd session..."
    systemctl set-environment WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
    systemctl set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
    systemctl set-environment MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT

    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment WLR_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT=1
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment MESA_VK_DEVICE_SELECT=$MESA_VK_SELECT

    echo "Creating isolated KDE Plasma environment config..."
    PLASMA_ENV_DIR="/home/$PRIMARY_USER/.config/plasma-workspace/env"
    sudo -u $PRIMARY_USER mkdir -p "$PLASMA_ENV_DIR"
    sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
EOF"
    chmod +x "$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh"

    echo "Daemon-reload..."
    systemctl daemon-reload
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user daemon-reload

  elif [ "$VENDOR" == "amd" ]; then
    echo "AMD Vendor detected. Injecting minimal variables..."
    mkdir -p /etc/environment.d
    echo "WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD" > /etc/environment.d/xgmobile-nvidia.conf
    systemctl set-environment WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user set-environment WLR_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD
  fi
fi

echo "Refreshing DRM session..."
systemctl start display-manager #--no-block

#if [ $SUPERGFX_TRIG == 1 ]; then
#  echo "Restarting supergfxctl..."
#  systemctl restart supergfxd.service 2>/dev/null || true
#fi
#This was too destructive for Flow Laptops
#if command -v supergfxctl >/dev/null 2>&1; then #[[ "$OS_TYPE" == *"bazzite"* || "$OS_TYPE" == "cachyos" ]]; then
#  echo "Supergfxctl Detected. Disabling so it does not interupt our boot..."
#  systemctl disable supergfxd.service 2>/dev/null || true
#fi

PRODUCT_NAME=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "Unknown")

if command -v supergfxctl >/dev/null 2>&1; then
  if [[ "$PRODUCT_NAME" == *"RC71L"* || "$PRODUCT_NAME" == *"Ally"* ]]; then
    echo "Handheld Detected ($PRODUCT_NAME). Disabling supergfxd to prevent interference..."
    systemctl disable supergfxd.service 2>/dev/null || true
  elif [[ "$PRODUCT_NAME" == *"Flow"* || "$PRODUCT_NAME" == *"GV"* || "$PRODUCT_NAME" == *"GZ"* ]]; then
    echo "Flow Laptop Detected ($PRODUCT_NAME). Leaving supergfxd active for MUX control..."
    # You can add supergfxctl restart logic here if Flow laptops require it after the WMI switch
  else
    echo "Unknown ASUS device ($PRODUCT_NAME). Leaving supergfxd alone."
  fi
fi

echo "--- Enable Finished at $(date): Time for God Mode ---"
sudo ln -sf "$LOG_DIR/xgmobile_manager_enable_${VENDOR}.log" $LOG_DIR/xgmobile_manager_enable_latest.log
