#!/bin/bash
VENDOR=$1
OS_TYPE=$2
PRIMARY_USER=$(ps -o user= -C steam | head -n 1 | xargs)
[ -z "$PRIMARY_USER" ] && PRIMARY_USER="deck"

ENABLE_PATH="/sys/devices/platform/asus-nb-wmi/egpu_enable"
if [ -f "$ENABLE_PATH" ]; then
    ACTIVE=$(cat "$ENABLE_PATH")
else
    ACTIVE="not_present"
fi

if [ "$ACTIVE" = "not_present" ]; then
    # CachyOS: BIOS-managed PCIe — egpu_enable sysfs absent.
    # The GPU may or may not be connected, but we can't tell from sysfs.
    # Always clean up NVIDIA boot state so a reboot without running egpu-eject
    # doesn't leave the system trying to start a display session against a half-configured NVIDIA setup.
    # egpu-enable re-creates these files when the user explicitly activates the eGPU.
    echo "NOTE: egpu_enable sysfs unavailable (CachyOS/BIOS-managed). Cleaning NVIDIA boot state..."
    rm -f /etc/environment.d/xgmobile-nvidia.conf
    rm -f /etc/modprobe.d/nvidia-egpu.conf
    rm -f "/home/$PRIMARY_USER/.config/plasma-workspace/env/xgmobile-nvidia-kwin.sh"
    # Do NOT disable the service — it must run on every boot to ensure clean state.
    exit 0
elif [ "$ACTIVE" -eq 0 ]; then
    echo "Failsafe triggered: XG Mobile is not physically connected."
    echo "Disabling sync service to clean up the environment."
    systemctl disable xgmobile-boot-sync.service 2>/dev/null
    rm -f "/home/$PRIMARY_USER/.config/plasma-workspace/env/xgmobile-nvidia-kwin.sh"
    exit 0
fi

echo "--- Boot DRM Sync Started at $(date) ---"

# Graceful exit for AMD users
if [ "$VENDOR" == "amd" ]; then
  echo "AMD eGPU detected. Native amdgpu drivers do not require DRM environment sync."
  echo "Sync complete (Skipped cleanly)."
  exit 0
fi

if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  # Foolproof detection of exact DRM nodes based on hardware vendor ID
  for card in /sys/class/drm/card*; do
    HW_VENDOR=$(cat $card/device/vendor 2>/dev/null)
    if [ "$HW_VENDOR" == "0x10de" ]; then # NVIDIA ID
      EGPU_CARD="/dev/dri/$(basename $card)"
    elif [ "$HW_VENDOR" == "0x1002" ] || [ "$HW_VENDOR" == "0x1022" ]; then # AMD IDs
      IGPU_CARD="/dev/dri/$(basename $card)"
    fi
  done

  if [ -z "$EGPU_CARD" ] || [ -z "$IGPU_CARD" ]; then
    echo "WARNING: Failed to detect both GPUs on the PCIe bus. Sync aborted."
    exit 1
  fi

  echo "Updating environment variables with fresh boot nodes: $IGPU_CARD (AMD) : $EGPU_CARD (NVIDIA)"

  # 1. Update the System-Wide Environment (drop-in file wins; legacy /etc/environment fallback)
  if [ -f /etc/environment.d/xgmobile-nvidia.conf ]; then
    sed -i 's|WLR_DRM_DEVICES=.*|WLR_DRM_DEVICES='$IGPU_CARD':'$EGPU_CARD'|' /etc/environment.d/xgmobile-nvidia.conf
  else
    steamos-readonly disable 2>/dev/null || true
    sed -i 's|WLR_DRM_DEVICES=.*|WLR_DRM_DEVICES='$IGPU_CARD':'$EGPU_CARD'|' /etc/environment
    steamos-readonly enable 2>/dev/null || true
  fi

  # 2. Update the Isolated Plasma Environment
  PLASMA_ENV_DIR="/home/$PRIMARY_USER/.config/plasma-workspace/env"
  sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$IGPU_CARD:$EGPU_CARD
EOF"
  echo "SteamOS/CachyOS specific DRM environment sync complete."
else
  echo "Bazzite OS detected. Skipping."
fi

echo "Sync complete. Ready for Desktop Mode."
